#!/usr/bin/env python3
import datetime
import email.utils
import json
import os
import sys
import time
import urllib.error
import urllib.request
import xml.etree.ElementTree as ET
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from urllib.parse import parse_qsl, urlencode, urlparse, urlunparse

CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
CONFIG = CONFIG_HOME / "omarchy-newsfeed" / "feeds.json"
CACHE_HOME = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
CACHE = CACHE_HOME / "omarchy-newsfeed" / "cache.json"
SEEN = CACHE_HOME / "omarchy-newsfeed" / "seen.json"
DEFAULT = [
    {"name": "Hacker News", "url": "https://news.ycombinator.com/rss"},
    {"name": "Omarchy News", "url": "https://omarchy.org/news/rss.xml"},
]
UA = "omarchy-newsfeed/0.7 (personal reader)"
ATOM_NS = "{http://www.w3.org/2005/Atom}"
LIMIT = 15
MAX_LIMIT = 50
MAX_FEEDS = 50
MAX_SEEN = 2000
MAX_BYTES = 2 * 1024 * 1024
TIMEOUT = 10
DEADLINE = 20  # shortcut: caps the body download only; connect and headers still use TIMEOUT per socket call, add a true total timeout if hosts stall there


def is_http(url):
    parts = urlparse(url)
    return parts.scheme in ("http", "https") and bool(parts.netloc)


def valid_feed(entry):
    if not isinstance(entry, dict):
        return None
    name, url = entry.get("name"), entry.get("url")
    if not isinstance(name, str) or not isinstance(url, str):
        return None
    name, url = name.strip(), url.strip()
    if not name or not is_http(url):
        return None
    limit = entry.get("limit")
    if isinstance(limit, bool) or not isinstance(limit, int):
        limit = None
    else:
        limit = max(1, min(MAX_LIMIT, limit))
    return {"name": name, "url": url, "enabled": entry.get("enabled") is not False, "limit": limit}


def active(entries):
    return [f for f in (valid_feed(e) for e in entries) if f and f["enabled"]]


def read_config():
    """Return (raw entries, error). A missing file or one with no valid feeds means the defaults."""
    try:
        raw = json.loads(CONFIG.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return [dict(f) for f in DEFAULT], None
    except OSError as e:
        return None, str(e)
    except ValueError:
        return None, "feeds.json is not valid JSON"
    if not isinstance(raw, list):
        return None, "feeds.json must be a JSON list"
    return raw, None


def load_feeds():
    raw, error = read_config()
    if error:
        return DEFAULT, error
    feeds = [f for f in (valid_feed(e) for e in raw[:MAX_FEEDS]) if f]
    return feeds or DEFAULT, None


def fail(message):
    return {"ok": False, "error": message}


def save_feeds(entries):
    try:
        write_json(CONFIG, entries, indent=2)
    except OSError as e:
        return fail(str(e))
    return {"ok": True}


def add_feed(url):
    url = url.strip()
    if not is_http(url):
        return fail("URL must start with http:// or https://")
    entries, error = read_config()
    if error:
        return fail(error)
    if len(entries) >= MAX_FEEDS:
        return fail("feeds.json already has %d feeds" % MAX_FEEDS)
    if any(isinstance(e, dict) and e.get("url") == url for e in entries):
        return fail("That feed is already in feeds.json")
    entries.append({"name": urlparse(url).netloc, "url": url})
    return save_feeds(entries)


def remove_feed(url):
    entries, error = read_config()
    if error:
        return fail(error)
    kept = [e for e in entries if not (isinstance(e, dict) and e.get("url") == url)]
    if len(kept) == len(entries):
        return fail("That feed is not in feeds.json")
    if not active(kept):
        return fail("Keep at least one enabled feed")
    return save_feeds(kept)


def toggle_feed(url):
    entries, error = read_config()
    if error:
        return fail(error)
    entry = next((e for e in entries if isinstance(e, dict) and e.get("url") == url), None)
    if entry is None:
        return fail("That feed is not in feeds.json")
    turn_on = entry.get("enabled") is False
    if not turn_on and not [f for f in active(entries) if f["url"] != url]:
        return fail("Keep at least one enabled feed")
    entry["enabled"] = turn_on
    return save_feeds(entries)


def utc_iso(dt):
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=datetime.timezone.utc)
    return dt.astimezone(datetime.timezone.utc).isoformat(timespec="seconds")


def parse_date(value):
    if not value:
        return ""
    try:
        return utc_iso(email.utils.parsedate_to_datetime(value))
    except (TypeError, ValueError):
        pass
    try:
        return utc_iso(datetime.datetime.fromisoformat(value.replace("Z", "+00:00")))
    except ValueError:
        return ""


def canonical(url):
    parts = urlparse(url)
    query = [(k, v) for k, v in parse_qsl(parts.query, keep_blank_values=True)
             if not k.startswith("utm_") and k not in ("fbclid", "gclid")]
    return urlunparse(parts._replace(query=urlencode(query)))


def make_item(title, url, date):
    title = title.strip() if isinstance(title, str) else ""
    url = url.strip() if isinstance(url, str) else ""
    date = date.strip() if isinstance(date, str) else ""
    if not title or not is_http(url):
        return None
    return {"title": title, "url": canonical(url), "published": parse_date(date)}


def parse_json_feed(data, limit):
    entries = json.loads(data).get("items")
    items = []
    for it in entries if isinstance(entries, list) else []:
        if not isinstance(it, dict):
            continue
        item = make_item(it.get("title"), it.get("url") or it.get("external_url"), it.get("date_published") or it.get("date_modified"))
        if item: items.append(item)
    return items[:limit]


def parse(data, limit=LIMIT):
    if data.lstrip()[:1] == b"{":
        return parse_json_feed(data, limit)
    if b"<!DOCTYPE" in data.upper():
        raise ValueError("DTD declarations are not allowed")
    root = ET.fromstring(data)
    items = []
    for it in root.iter("item"):  # RSS
        item = make_item(it.findtext("title"), it.findtext("link"), it.findtext("pubDate"))
        if item: items.append(item)
    for en in root.iter(ATOM_NS + "entry"):  # Atom
        links = [l for l in en.findall(ATOM_NS + "link") if l.get("rel", "alternate") == "alternate"]
        href = links[0].get("href") if links else ""
        date = en.findtext(ATOM_NS + "updated") or en.findtext(ATOM_NS + "published")
        item = make_item(en.findtext(ATOM_NS + "title"), href, date)
        if item: items.append(item)
    return items[:limit]


def read_body(r, deadline):
    data = bytearray()
    while True:
        if time.monotonic() > deadline:
            raise TimeoutError("timed out")
        chunk = r.read(64 * 1024)
        if not chunk:
            return bytes(data)
        data += chunk
        if len(data) > MAX_BYTES:
            raise ValueError("feed is larger than 2 MB")


def fetch(feed, limit=LIMIT, prior=None):
    prior = prior or {}
    try:
        deadline = time.monotonic() + DEADLINE
        headers = {"User-Agent": UA}
        if prior.get("etag"):
            headers["If-None-Match"] = prior["etag"]
        if prior.get("modified"):
            headers["If-Modified-Since"] = prior["modified"]
        req = urllib.request.Request(feed["url"], headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
                data = read_body(r, deadline)
                etag, modified = r.headers.get("ETag"), r.headers.get("Last-Modified")
        except urllib.error.HTTPError as e:
            if e.code != 304:
                raise
            e.close()
            return {"name": feed["name"], "items": prior["items"][:limit], "error": None, "etag": prior.get("etag"), "modified": prior.get("modified")}
        return {"name": feed["name"], "items": parse(data, limit), "error": None, "etag": etag, "modified": modified}
    except Exception as e:
        return {"name": feed["name"], "items": [], "error": str(e) or type(e).__name__}


def write_json(path, data, indent=None):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path.parent, 0o700)
    tmp = path.with_name(path.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        os.fchmod(f.fileno(), 0o600)
        f.write(json.dumps(data, ensure_ascii=False, indent=indent))
    tmp.replace(path)


def load_list(path):
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    if not isinstance(raw, list):
        return []
    return raw


def load_cache():
    entries = [f for f in load_list(CACHE) if isinstance(f, dict) and isinstance(f.get("items"), list)]
    for f in entries:
        f["items"] = [dict(i, url=canonical(i["url"])) if isinstance(i, dict) and isinstance(i.get("url"), str) else i for i in f["items"]]
    return entries


def save_cache(entries):
    try:
        write_json(CACHE, entries)
    except OSError:
        pass


def load_seen():
    return [canonical(u) for u in load_list(SEEN) if isinstance(u, str)]


def update_seen(urls, mark):
    seen = load_seen()
    urls = [canonical(u.strip()) for u in urls]
    if mark:
        new = [u for u in dict.fromkeys(urls) if is_http(u)]
        seen = [u for u in seen if u not in set(new)] + new
    else:
        drop = set(urls)
        seen = [u for u in seen if u not in drop]
    try:
        write_json(SEEN, seen[-MAX_SEEN:])
    except OSError as e:
        return fail(str(e))
    return {"ok": True}


def mark_read(urls):
    return update_seen(urls, True)


def unmark_read(urls):
    return update_seen(urls, False)


def tighten_old_files():
    for path, mode in ((CACHE.parent, 0o700), (CACHE, 0o600), (SEEN, 0o600)):
        try:
            os.chmod(path, mode)
        except OSError:
            pass


def fetch_one(feed, limit, prior=None):
    if feed.get("enabled") is False:
        return {"name": feed["name"], "items": [], "error": None, "disabled": True}
    return fetch(feed, feed.get("limit") or limit, prior)


def run(feeds, limit=LIMIT):
    cached = {f.get("url"): f for f in load_cache()}
    with ThreadPoolExecutor(max_workers=8) as pool:
        results = list(pool.map(lambda f: fetch_one(f, limit, cached.get(f["url"])), feeds))
    now = utc_iso(datetime.datetime.now(datetime.timezone.utc))
    for feed, r in zip(feeds, results):
        prior = cached.get(feed["url"], {})
        r["url"] = feed["url"]
        r["last_ok"] = prior.get("last_ok")
        r["failing_since"] = None
        if r["error"]:
            r["failing_since"] = prior.get("failing_since") or now
            if feed["url"] in cached:
                r["items"] = prior["items"]
        elif not r.get("disabled"):
            r["last_ok"] = now
    save_cache([{k: r.get(k) for k in ("name", "url", "items", "disabled", "etag", "modified", "last_ok", "failing_since")} for r in results])
    return results


def dedupe(results):
    urls = set()
    for r in results:
        fresh = []
        for i in r["items"]:
            if i["url"] not in urls:
                urls.add(i["url"])
                fresh.append(i)
        r["items"] = fresh


def parse_limit(args):
    try:
        n = int(args[args.index("--limit") + 1])
    except (ValueError, IndexError):
        return LIMIT
    return max(1, min(MAX_LIMIT, n))


def main():
    tighten_old_files()
    args = sys.argv[1:]
    cmd = args[0] if args else ""
    if cmd == "--cached":
        out = load_cache()
    elif cmd == "--seen":
        out = load_seen()
    elif cmd == "--mark-read":
        out = mark_read(args[1:])
    elif cmd == "--unmark-read":
        out = unmark_read(args[1:])
    elif cmd == "--add-feed":
        out = add_feed(args[1] if len(args) > 1 else "")
    elif cmd == "--remove-feed":
        out = remove_feed(args[1] if len(args) > 1 else "")
    elif cmd == "--toggle-feed":
        out = toggle_feed(args[1] if len(args) > 1 else "")
    else:
        feeds, error = load_feeds()
        out = run(feeds, parse_limit(args))
        dedupe(out)
        if error:
            out.insert(0, {"name": "Feed config", "url": "", "items": [], "error": error})
    sys.stdout.buffer.write(json.dumps(out, ensure_ascii=False).encode("utf-8") + b"\n")


if __name__ == "__main__":
    main()
